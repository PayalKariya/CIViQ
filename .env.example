# Turso database
TURSO_CONNECTION_URL=
TURSO_AUTH_TOKEN=

# Google AI — CIViQ+ in-app assistant (Gemini). Create a key in Google AI Studio.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: preferred model. If it hits quota/404, the API tries other models automatically.
# Examples: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-1.5-flash, gemini-2.0-flash
# GEMINI_MODEL=gemini-2.5-flash-lite

# LocationIQ — reverse geocode for “Get current location” (server-side only).
# Dashboard: https://locationiq.com/ — use your access token.
# Optional EU endpoint: LOCATIONIQ_API_BASE_URL=https://eu1.locationiq.com
LOCATIONIQ_ACCESS_TOKEN=
